{
  "name": "git-architecture-diagram",
  "version": "1.1.0",
  "description": "Mermaid architecture, repository trees, and source-grounded Genius guides for GitHub repositories.",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-only",
  "author": "Amine Saoud ibn al-Bashir",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env server.mjs",
    "dev": "node --env-file-if-exists=.env --watch server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "node scripts/check.mjs",
    "analyze": "node --env-file-if-exists=.env cli.mjs",
    "build": "node scripts/build.mjs",
    "test:browser": "node --test tests/browser/*.browser.mjs",
    "scan:secrets": "node scripts/secret-scan.mjs",
    "provenance": "node scripts/provenance.mjs",
    "brand:social": "node scripts/social-glyphs.mjs"
  },
  "dependencies": {
    "dompurify": "^3.4.16",
    "fflate": "^0.8.3",
    "marked": "^17.0.6",
    "mermaid": "^11.17.2"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "4.20260730.0",
    "playwright": "^1.56.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.0",
      "sharp": "0.35.4"
    }
  }
}
