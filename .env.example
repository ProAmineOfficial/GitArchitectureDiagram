# Project: Git Architecture Diagram; developed by Amine Saoud ibn al-Bashir.
PORT=3000
HOST=127.0.0.1
# Optional public-repository rate-limit token; private repositories require a request-specific token.
GITHUB_TOKEN=
# Optional AI provider; choose a model available in your OpenAI account.
OPENAI_API_KEY=
GENIUS_MODEL=
# Protect hosted AI usage and all analysis routes with this optional shared access password.
GENIUS_ACCESS_TOKEN=
# Your public origin is required behind a reverse proxy, for same-origin request validation.
PUBLIC_ORIGIN=
# Hosted Worker only: optional comma-separated exact HTTPS origins when both generated and custom domains are used.
PUBLIC_ORIGINS=
