# Project: Git Architecture Diagram; developed by Amine Saoud ibn al-Bashir.
PORT=3000
HOST=127.0.0.1
# Optional public-repository rate-limit token; private repositories require a request-specific token.
GITHUB_TOKEN=
# Optional AI provider: openai, anthropic, gemini, kimi, or deepseek.
GENIUS_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
GENIUS_MODEL=
# Protect hosted AI usage and all analysis routes with this optional shared access password.
GENIUS_ACCESS_TOKEN=
# Your public origin is required behind a reverse proxy, for same-origin request validation.
PUBLIC_ORIGIN=
# Hosted Worker only: optional comma-separated exact HTTPS origins when both generated and custom domains are used.
PUBLIC_ORIGINS=

# Optional: generate system maps for every visitor of public repositories with the key above.
# Each commit, folder, and model is generated once and then served from cache. The limit counts real model calls per UTC day.
GENIUS_PUBLIC_AI=
GENIUS_PUBLIC_DAILY_LIMIT=25
