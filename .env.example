# Project: Git Architecture Diagram; developed by Amine Saoud ibn al-Bashir.
# Copy to .env for local use. Every value here is an empty placeholder or a non-secret setting.
# Never put a real key in this file: .env is ignored by Git, .env.example is public.
PORT=3000
HOST=127.0.0.1
# Your public origin, without a trailing slash; required behind a reverse proxy for same-origin request validation.
# Production: PUBLIC_ORIGIN=https://gitarchitecturediagram.com (leave empty for local development).
PUBLIC_ORIGIN=
# Hosted Worker only: optional comma-separated exact HTTPS origins when both generated and custom domains are used.
PUBLIC_ORIGINS=

# Optional server-side GitHub token: raises the public-repository API allowance. It is never sent by the browser
# and never opens private repositories to visitors. The command-line tool also uses it for your private repositories.
GITHUB_TOKEN=

# Saved public analyses (Node server only). Default: the .cache/analysis folder next to server.mjs.
# Set a writable folder outside the deployment directory to keep them across redeploys, or "off" for memory only.
GAD_CACHE_DIR=

# Optional operator AI key, used only for opted-in public system maps (GENIUS_PUBLIC_AI=1) and the local CLI.
# Visitors use their own key in API settings; a web request never borrows these.
GENIUS_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
MOONSHOT_API_KEY=
DEEPSEEK_API_KEY=
GENIUS_MODEL=

# Optional: generate system maps for every visitor of public repositories with the key above.
# Each commit, folder, and model is generated once and then served from cache. The limit counts real model calls per UTC day.
GENIUS_PUBLIC_AI=
GENIUS_PUBLIC_DAILY_LIMIT=25

# Optional: Make Any Product with Genius AI. The private Genius Engineering Engine runs as a separate service.
# HTTPS URL (http only for localhost) and a shared token of 32+ characters; set real values in the hosting panel only.
# Without them, the idea workspace shows the labeled ESP32 example. The engine never receives visitor keys.
GENIUS_ENGINE_URL=
GENIUS_ENGINE_TOKEN=
